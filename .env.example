# 可选：不填写 API Key 也能进行原题、模糊和全文检索。
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
EMBEDDING_MODEL=text-embedding-v4

# 本地可留空；公网部署必须填写至少 32 字符的随机令牌。
QABANK_ACCESS_TOKEN=
QABANK_REQUIRE_AUTH=false
QABANK_MAX_QUERY_CHARS=2000
QABANK_RATE_LIMIT_REQUESTS=20
QABANK_RATE_LIMIT_WINDOW_SECONDS=60

# Docker Compose 会覆盖这两个路径。
QABANK_RUNTIME_DIR=./runtime
QABANK_SOURCE_DOCX=./source/question_bank.docx
QABANK_EXPECTED_COUNT=4180

# 只有完成 scripts/build_embeddings.py 后才建议启用语义检索。
QABANK_ENABLE_SEMANTIC=false
QABANK_ENABLE_LLM_EXPLANATION=false
QABANK_AUTO_MATCH_THRESHOLD=0.90
QABANK_AUTO_MATCH_MARGIN=0.04
QABANK_CANDIDATE_THRESHOLD=0.55
